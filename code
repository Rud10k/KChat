<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>KChat - Animated Edition</title>
    <!-- PeerJS biblioteka -->
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        /* Animacijos */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .animate-fade {
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Tema: Default (Raudona - Geltona) */
        body.theme-default {
            background: linear-gradient(135deg, #ffd000 0%, #ff5500 50%, #d00000 100%);
            color: #000;
        }
        /* Tema: Balta (White) */
        body.theme-white {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            color: #1a1a1a;
        }
        /* Tema: Pilka (Grey) */
        body.theme-grey {
            background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);
            color: #ffffff;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
            height: 100vh;
            height: -webkit-fill-available;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            transition: background 0.5s ease;
        }

        html { height: -webkit-fill-available; }

        /* --- 1 LANGAS: PRISIJUNGIMAS (LOGIN SCREEN) --- */
        #login-section {
            position: relative;
            width: 100vw;
            height: 100vh;
            padding: calc(20px + env(safe-area-inset-top)) 24px calc(20px + env(safe-area-inset-bottom)) 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
        }

        .login-top-title {
            font-size: clamp(32px, 8vw, 44px);
            font-weight: 900;
            letter-spacing: -1.5px;
        }

        .login-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            gap: 20px;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 100%;
            max-width: 420px;
        }

        .pill-input {
            background: rgba(235, 235, 235, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 16px 22px;
            border-radius: 35px;
            font-size: 18px;
            color: #000;
            outline: none;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            width: 100%;
            transition: all 0.3s ease;
        }
        .pill-input:focus {
            background: #ffffff;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            transform: scale(1.01);
        }
        .pill-input::placeholder { color: #666; }

        .color-picker-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: rgba(235, 235, 235, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 8px 16px 8px 22px;
            border-radius: 35px;
        }

        .color-label {
            font-size: 15px;
            font-weight: 700;
            color: #333;
        }

        .color-picker-btn {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 2px solid #fff;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            padding: 0;
            background: transparent;
            overflow: hidden;
            transition: transform 0.2s;
        }
        .color-picker-btn:hover { transform: scale(1.08); }
        .color-picker-btn::-webkit-color-swatch-wrapper { padding: 0; }
        .color-picker-btn::-webkit-color-swatch { border: none; border-radius: 50%; }

        .avatar-picker-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(235, 235, 235, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 8px 16px 8px 22px;
            border-radius: 35px;
        }

        .avatar-preview-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            display: none;
            border: 2px solid #fff;
        }

        .avatar-upload-btn {
            background: rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(0,0,0,0.2);
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        .avatar-upload-btn:hover { background: rgba(0, 0, 0, 0.2); }

        .login-right-text {
            font-size: clamp(28px, 6vw, 50px);
            font-family: monospace;
            font-weight: 800;
            max-width: 520px;
            line-height: 1.1;
            text-align: right;
        }

        .login-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            width: 100%;
            margin-top: 15px;
        }

        .kero-tag {
            font-size: clamp(24px, 5vw, 36px);
            color: #fff;
            font-weight: 900;
            text-shadow: 0 4px 15px rgba(0,0,0,0.25);
        }

        .gemini-tag {
            font-size: clamp(20px, 4.5vw, 36px);
            font-family: monospace;
            text-align: right;
            font-weight: bold;
        }

        .btn-start {
            background: #10b981;
            color: white;
            border: none;
            padding: 16px;
            border-radius: 35px;
            font-size: 18px;
            cursor: pointer;
            font-weight: 800;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.45);
            width: 100%;
            transition: transform 0.2s, background 0.2s;
        }
        .btn-start:active {
            transform: scale(0.98);
            background: #059669;
        }

        /* --- 2 LANGAS: CHAT SĄSAVA --- */
        #chat-section {
            display: none;
            width: 100vw;
            height: 100vh;
            flex-direction: column;
            position: relative;
        }

        .chat-main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            padding: calc(10px + env(safe-area-inset-top)) 20px calc(15px + env(safe-area-inset-bottom)) 20px;
            height: 100%;
            width: 100%;
        }

        .chat-header-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 5px 5px 10px 5px;
            z-index: 10;
        }

        .themes-btn {
            background: rgba(18, 18, 24, 0.65);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 10px 20px;
            border-radius: 22px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s;
        }
        .themes-btn:active { transform: scale(0.94); }

        #messages-container {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-bottom: 90px;
            padding-right: 5px;
            scroll-behavior: smooth;
            width: 100%;
        }

        .msg-wrapper {
            display: flex;
            flex-direction: column;
            max-width: 75%;
            position: relative;
        }

        .msg-wrapper.my-msg { align-self: flex-end; }
        .msg-wrapper.other-msg { align-self: flex-start; }

        .msg-author-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
            margin-left: 6px;
        }

        .msg-author-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            object-fit: cover;
        }

        .msg-author-name {
            font-size: 12px;
            font-weight: 700;
            opacity: 0.8;
        }

        .msg-bubble {
            padding: 14px 22px;
            border-radius: 26px;
            font-size: 18px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
            word-break: break-word;
            cursor: pointer;
            user-select: none;
            position: relative;
            transform-origin: center;
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .msg-bubble img.chat-img {
            max-width: 100%;
            max-height: 350px;
            border-radius: 18px;
            margin-bottom: 6px;
            display: block;
            object-fit: cover;
            cursor: zoom-in;
        }

        .msg-reactions {
            display: flex;
            gap: 4px;
            position: absolute;
            bottom: -10px;
            right: 12px;
            background: rgba(18, 18, 24, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 14px;
            padding: 2px 8px;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
            color: #fff;
            animation: popIn 0.2s ease-out;
        }

        /* Dynamic iOS Dark Liquid Glass Input Bar */
        .glass-input-bar {
            position: absolute;
            bottom: calc(15px + env(safe-area-inset-bottom));
            left: 20px;
            right: 20px;
            height: 65px;
            background: rgba(18, 18, 24, 0.65);
            backdrop-filter: blur(30px) saturate(200%);
            -webkit-backdrop-filter: blur(30px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 40px;
            display: flex;
            align-items: center;
            padding: 6px 12px 6px 18px;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.45);
            z-index: 20;
        }

        .glass-input-bar input[type="text"] {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            font-size: 18px;
            color: #ffffff;
            min-width: 0;
        }
        .glass-input-bar input[type="text"]::placeholder {
            color: rgba(255, 255, 255, 0.55);
        }

        .glass-send-btn {
            background: rgba(255, 255, 255, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.35);
            color: white;
            padding: 12px 28px;
            border-radius: 30px;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
            backdrop-filter: blur(12px);
            white-space: nowrap;
            transition: transform 0.2s, background 0.2s;
        }
        .glass-send-btn:active {
            background: rgba(255, 255, 255, 0.45);
            transform: scale(0.95);
        }

        .file-attach-plus-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            font-size: 24px;
            font-weight: 300;
            cursor: pointer;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 0;
            transition: transform 0.2s;
        }
        .file-attach-plus-btn:active { transform: scale(0.9); }

        /* --- LIQUID GLASS THEMES POPUP MENU --- */
        .themes-modal {
            display: none;
            position: absolute;
            top: calc(65px + env(safe-area-inset-top));
            right: 20px;
            width: 260px;
            background: rgba(20, 20, 28, 0.75);
            backdrop-filter: blur(35px) saturate(210%);
            -webkit-backdrop-filter: blur(35px) saturate(210%);
            border-radius: 26px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            z-index: 100;
            flex-direction: column;
            gap: 12px;
            transform: translateY(-10px) scale(0.95);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .themes-modal.show {
            display: flex;
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .themes-modal h4 {
            margin: 0 0 6px 0;
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            text-align: center;
        }

        .theme-option-btn {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 12px 16px;
            border-radius: 18px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: transform 0.2s;
        }
        .theme-option-btn:active {
            background: rgba(255, 255, 255, 0.28);
            transform: scale(0.96);
        }

        /* --- REACTION PICKER POPUP --- */
        .reaction-picker-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s ease;
        }

        .reaction-box {
            background: rgba(20, 20, 28, 0.85);
            backdrop-filter: blur(30px) saturate(200%);
            -webkit-backdrop-filter: blur(30px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 30px;
            padding: 12px 20px;
            display: flex;
            gap: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .reaction-emoji {
            font-size: 32px;
            cursor: pointer;
            transition: transform 0.15s;
        }
        .reaction-emoji:hover, .reaction-emoji:active {
            transform: scale(1.35);
        }

        /* PHOTO ZOOM MODAL */
        .zoom-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(15px);
            z-index: 1001;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            animation: fadeIn 0.3s ease;
        }

        .zoom-modal img {
            max-width: 90vw;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
            animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .zoom-close-btn {
            position: absolute;
            top: 20px;
            right: 25px;
            color: white;
            font-size: 30px;
            cursor: pointer;
            font-weight: bold;
            z-index: 1002;
            background: rgba(255,255,255,0.2);
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        @media (max-width: 768px) {
            .login-main { flex-direction: column; align-items: stretch; }
            .login-right-text { text-align: left; margin-top: 10px; }
            .msg-wrapper { max-width: 88%; }
            .glass-input-bar { left: 12px; right: 12px; }
        }
    </style>
</head>
<body class="theme-default animate-fade">

    <!-- 1 LANGAS: PRISIJUNGIMAS -->
    <div id="login-section">
        <div class="login-top-title">KChat</div>

        <div class="login-main">
            <div class="login-form">
                <input type="text" id="room-name" class="pill-input" placeholder="room name">
                <input type="text" id="room-code" class="pill-input" placeholder="room code (any length)">
                <input type="text" id="username" class="pill-input" placeholder="your user name">

                <!-- Profilio Nuotrauka -->
                <div class="avatar-picker-row">
                    <span class="color-label" style="background:transparent; padding:0;">profile photo (optional)</span>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <img id="avatar-preview" class="avatar-preview-img" alt="Avatar">
                        <label class="avatar-upload-btn">
                            choose file
                            <input type="file" id="avatar-file" accept="image/*" style="display:none;" onchange="handleAvatarUpload(event)">
                        </label>
                    </div>
                </div>

                <!-- Random Bubble Color Picker -->
                <div class="color-picker-row">
                    <span class="color-label">chat bubble color</span>
                    <input type="color" id="bubble-color" class="color-picker-btn" value="#007bff">
                </div>

                <button class="btn-start" onclick="connectToChat()">Start / Join Chat</button>
            </div>

            <div class="login-right-text">
                free end-to-end<br>
                messenger
            </div>
        </div>

        <div class="login-footer">
            <div class="kero-tag">Kero Co.©</div>
            <div class="gemini-tag">created using<br>gemini</div>
        </div>
    </div>

    <!-- 2 LANGAS: POKALBIS -->
    <div id="chat-section">
        <div class="chat-main-area">
            <div class="chat-header-actions">
                <button class="themes-btn" onclick="toggleThemesMenu()">🎨 Themes</button>
            </div>

            <!-- LIQUID GLASS THEMES POPUP MENU -->
            <div class="themes-modal" id="themes-modal">
                <h4>Select App Theme</h4>
                <button class="theme-option-btn" onclick="applyTheme('theme-default')">🌈 Default (Red-Yellow)</button>
                <button class="theme-option-btn" onclick="applyTheme('theme-white')">⚪ White Theme</button>
                <button class="theme-option-btn" onclick="applyTheme('theme-grey')">🌑 Grey Theme</button>
            </div>

            <!-- Messages Container -->
            <div id="messages-container"></div>

            <!-- Dark Liquid Glass Input Bar -->
            <div class="glass-input-bar">
                <label class="file-attach-plus-btn" title="Attach file or image">
                    +
                    <input type="file" id="file-input" style="display:none;" onchange="sendFile(event)">
                </label>
                <input type="text" id="msg-input" placeholder="enter text..." onkeypress="handleEnter(event)">
                <button class="glass-send-btn" onclick="sendTextMessage()">send</button>
            </div>
        </div>
    </div>

    <!-- REACTION PICKER MODAL -->
    <div class="reaction-picker-modal" id="reaction-modal" onclick="closeReactionModal()">
        <div class="reaction-box" onclick="event.stopPropagation()">
            <span class="reaction-emoji" onclick="addReaction('❤️')">❤️</span>
            <span class="reaction-emoji" onclick="addReaction('👍')">👍</span>
            <span class="reaction-emoji" onclick="addReaction('😂')">😂</span>
            <span class="reaction-emoji" onclick="addReaction('🔥')">🔥</span>
            <span class="reaction-emoji" onclick="addReaction('😮')">😮</span>
            <span class="reaction-emoji" onclick="addReaction('👏')">👏</span>
        </div>
    </div>

    <!-- PHOTO ZOOM MODAL -->
    <div class="zoom-modal" id="zoom-modal" onclick="closeZoomModal()">
        <div class="zoom-close-btn">&times;</div>
        <img id="zoom-img" src="" alt="Zoomed Image" onclick="event.stopPropagation()">
    </div>

    <script>
        let peer = null;
        let connections = {};
        let myName = '';
        let myColor = '#007bff';
        let myAvatar = null;
        let currentRoom = '';
        let selectedMsgId = null;

        // Sugeneruoti atsitiktinę (random) spalvą kiekvieno prisijungimo metu
        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        // Paleidus puslapį, priskiriame atsitiktinę spalvą
        window.addEventListener('DOMContentLoaded', () => {
            const randomHex = getRandomColor();
            document.getElementById('bubble-color').value = randomHex;
            myColor = randomHex;
        });

        function handleAvatarUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    myAvatar = evt.target.result;
                    const preview = document.getElementById('avatar-preview');
                    preview.src = myAvatar;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function applyTheme(themeClass) {
            document.body.className = themeClass + ' animate-fade';
            toggleThemesMenu();
        }

        function toggleThemesMenu() {
            const menu = document.getElementById('themes-modal');
            menu.classList.toggle('show');
        }

        function connectToChat() {
            const roomName = document.getElementById('room-name').value.trim().toLowerCase();
            const roomCode = document.getElementById('room-code').value.trim();
            myName = document.getElementById('username').value.trim();
            myColor = document.getElementById('bubble-color').value || '#007bff';

            if (!roomName || !roomCode || !myName) {
                alert('Please fill in room name, room code, and username!');
                return;
            }

            currentRoom = roomName + '-' + roomCode;
            const myPeerId = 'kchat-' + Math.random().toString(36).substr(2, 9);
            peer = new Peer(myPeerId);

            peer.on('open', (id) => {
                enterChatUI();

                const roomHostId = 'kchat-host-' + btoa(unescape(encodeURIComponent(currentRoom))).replace(/=/g, '');
                
                let hostConn = peer.connect(roomHostId);
                hostConn.on('open', () => {
                    setupConnection(hostConn);
                });

                let hostPeer = new Peer(roomHostId);
                hostPeer.on('connection', (conn) => {
                    setupConnection(conn);
                });
            });

            peer.on('connection', (conn) => {
                setupConnection(conn);
            });
        }

        function setupConnection(conn) {
            connections[conn.peer] = conn;

            conn.on('open', () => {
                conn.send({ type: 'handshake', name: myName, color: myColor, avatar: myAvatar });
            });

            conn.on('data', (data) => {
                if (data.type === 'msg') {
                    renderMessage(data.text, data.name, data.color, false, data.image, data.msgId, data.avatar);
                } else if (data.type === 'reaction') {
                    applyReactionToUI(data.msgId, data.emoji);
                }
            });

            conn.on('close', () => {
                delete connections[conn.peer];
            });
        }

        function sendTextMessage() {
            const input = document.getElementById('msg-input');
            const text = input.value.trim();
            if (text) {
                const msgId = 'msg-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);
                const msgData = { type: 'msg', text: text, name: myName, color: myColor, avatar: myAvatar, msgId: msgId };
                
                broadcast(msgData);
                renderMessage(text, myName, myColor, true, null, msgId, myAvatar);
                input.value = '';
            }
        }

        function sendFile(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                const isImg = file.type.startsWith('image/');
                const msgId = 'msg-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);
                const msgData = {
                    type: 'msg',
                    text: isImg ? file.name : 'Sent a file: ' + file.name,
                    image: isImg ? evt.target.result : null,
                    name: myName,
                    color: myColor,
                    avatar: myAvatar,
                    msgId: msgId
                };
                broadcast(msgData);
                renderMessage(msgData.text, myName, myColor, true, msgData.image, msgId, myAvatar);
            };
            reader.readAsDataURL(file);
        }

        function broadcast(data) {
            Object.values(connections).forEach(conn => {
                if (conn && conn.open) conn.send(data);
            });
        }

        function renderMessage(text, author, color, isMe, imageBase64 = null, msgId = null, avatarBase64 = null) {
            const container = document.getElementById('messages-container');
            const wrapper = document.createElement('div');
            wrapper.className = 'msg-wrapper ' + (isMe ? 'my-msg' : 'other-msg');
            if (msgId) wrapper.id = msgId;

            const authorRow = document.createElement('div');
            authorRow.className = 'msg-author-row';

            if (avatarBase64) {
                const avatarImg = document.createElement('img');
                avatarImg.src = avatarBase64;
                avatarImg.className = 'msg-author-avatar';
                authorRow.appendChild(avatarImg);
            }

            const authorDiv = document.createElement('div');
            authorDiv.className = 'msg-author-name';
            authorDiv.innerText = author;
            authorRow.appendChild(authorDiv);

            const bubble = document.createElement('div');
            bubble.className = 'msg-bubble';
            bubble.style.backgroundColor = color;
            bubble.style.color = isLightColor(color) ? '#000000' : '#ffffff';

            let lastTap = 0;
            bubble.addEventListener('touchend', function(e) {
                const currentTime = new Date().getTime();
                const tapLength = currentTime - lastTap;
                if (tapLength < 300 && tapLength > 0) {
                    openReactionModal(msgId);
                    e.preventDefault();
                }
                lastTap = currentTime;
            });

            bubble.addEventListener('dblclick', function() {
                openReactionModal(msgId);
            });

            if (imageBase64) {
                const img = document.createElement('img');
                img.src = imageBase64;
                img.className = 'chat-img';
                img.onclick = (e) => {
                    e.stopPropagation();
                    openZoomModal(imageBase64);
                };
                bubble.appendChild(img);
            }

            const textSpan = document.createElement('span');
            textSpan.innerText = text;
            bubble.appendChild(textSpan);

            const reactionsDiv = document.createElement('div');
            reactionsDiv.className = 'msg-reactions';
            reactionsDiv.style.display = 'none';
            bubble.appendChild(reactionsDiv);

            wrapper.appendChild(authorRow);
            wrapper.appendChild(bubble);
            container.appendChild(wrapper);
            container.scrollTop = container.scrollHeight;
        }

        function openReactionModal(msgId) {
            selectedMsgId = msgId;
            document.getElementById('reaction-modal').style.display = 'flex';
        }

        function closeReactionModal() {
            document.getElementById('reaction-modal').style.display = 'none';
            selectedMsgId = null;
        }

        function addReaction(emoji) {
            if (selectedMsgId) {
                applyReactionToUI(selectedMsgId, emoji);
                broadcast({ type: 'reaction', msgId: selectedMsgId, emoji: emoji });
            }
            closeReactionModal();
        }

        function applyReactionToUI(msgId, emoji) {
            const wrapper = document.getElementById(msgId);
            if (wrapper) {
                const reactionsDiv = wrapper.querySelector('.msg-reactions');
                if (reactionsDiv) {
                    reactionsDiv.style.display = 'flex';
                    reactionsDiv.innerText = emoji;
                }
            }
        }

        function handleEnter(e) {
            if (e.key === 'Enter') sendTextMessage();
        }

        function enterChatUI() {
            const loginSec = document.getElementById('login-section');
            loginSec.style.opacity = '0';
            setTimeout(() => {
                loginSec.style.display = 'none';
                const chatSec = document.getElementById('chat-section');
                chatSec.style.display = 'flex';
                chatSec.classList.add('animate-fade');
            }, 300);
        }

        function openZoomModal(src) {
            const modal = document.getElementById('zoom-modal');
            const img = document.getElementById('zoom-img');
            img.src = src;
            modal.style.display = 'flex';
        }

        function closeZoomModal() {
            document.getElementById('zoom-modal').style.display = 'none';
        }

        function isLightColor(hex) {
            if (hex.startsWith('#')) hex = hex.substring(1);
            if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
            const num = parseInt(hex, 16);
            if (isNaN(num)) return true;
            const r = (num >> 16) & 255;
            const g = (num >> 8) & 255;
            const b = num & 255;
            return (0.2126 * r + 0.7152 * g + 0.0722 * b) > 128;
        }
    </script>
</body>
</html>
